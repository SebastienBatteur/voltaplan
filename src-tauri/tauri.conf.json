{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Voltaplan",
  "version": "0.1.0",
  "identifier": "app.voltaplan.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "npm run dev -- --port 5174 --strictPort",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Voltaplan",
        "width": 1280,
        "height": 820,
        "minWidth": 800,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "license": "AGPL-3.0-or-later",
    "licenseFile": "../LICENSE",
    "shortDescription": "Schémas unifilaires et plans de position électriques",
    "longDescription": "Application open source pour dessiner les schémas unifilaires, plans de position et tableaux électriques, avec contrôle des règles nationales (RGIE en Belgique).",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
