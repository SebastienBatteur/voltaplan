{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri"
    },
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "project": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "description": "Permanent project identifier (urn:uuid), independent of name, repository and domain"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "additionalProperties": false
    },
    "subject": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string"
        },
        "commit": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "type": "string",
          "enum": [
            "build",
            "source"
          ]
        }
      },
      "required": [
        "version",
        "commit",
        "kind"
      ],
      "additionalProperties": false
    },
    "integrity": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "algorithm": {
              "type": "string",
              "const": "sha256"
            },
            "note": {
              "type": "string"
            },
            "files": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "size": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "path",
                  "sha256",
                  "size"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "algorithm",
            "note",
            "files"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "sources": {
      "type": "object",
      "properties": {
        "algorithm": {
          "type": "string",
          "const": "sha256"
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "path",
              "sha256"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "algorithm",
        "files"
      ],
      "additionalProperties": false
    },
    "similarity": {
      "type": "object",
      "properties": {
        "algorithm": {
          "type": "string",
          "description": "Identifier of the normalisation and hashing algorithm"
        },
        "shingle": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "sketch": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "background": {
          "type": "string",
          "description": "How generic code was excluded"
        },
        "disclaimer": {
          "type": "string"
        },
        "components": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "paths": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "strings": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{16}$"
                }
              },
              "tokens": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{16}$"
                }
              },
              "counts": {
                "type": "object",
                "properties": {
                  "strings": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  "shingles": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "strings",
                  "shingles"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "name",
              "description",
              "paths",
              "strings",
              "tokens",
              "counts"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "algorithm",
        "shingle",
        "sketch",
        "background",
        "disclaimer",
        "components"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "$schema",
    "schemaVersion",
    "project",
    "subject",
    "integrity",
    "sources",
    "similarity"
  ],
  "additionalProperties": false,
  "$id": "https://voltaplan.org/schemas/oss-provenance/fingerprints-1.0.schema.json",
  "title": "oss-provenance fingerprints-1.0"
}
