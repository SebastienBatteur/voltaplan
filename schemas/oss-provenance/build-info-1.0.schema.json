{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri"
    },
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "project": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "description": "Permanent project identifier (urn:uuid), independent of name, repository and domain"
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "name": {
          "type": "string"
        },
        "homepage": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri"
            },
            {
              "type": "null"
            }
          ]
        },
        "metadata": {
          "type": "string",
          "description": "CodeMeta file, relative to the repository root"
        }
      },
      "required": [
        "id",
        "aliases",
        "name",
        "homepage",
        "metadata"
      ],
      "additionalProperties": false
    },
    "upstream": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "description": "Permanent project identifier (urn:uuid), independent of name, repository and domain"
        },
        "repository": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "id",
        "repository"
      ],
      "additionalProperties": false,
      "description": "Original project this build descends from (kept by forks that keep their lineage)"
    },
    "repository": {
      "type": "object",
      "properties": {
        "url": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri"
            },
            {
              "type": "null"
            }
          ]
        },
        "commit": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "commitDate": {
          "type": [
            "string",
            "null"
          ]
        },
        "dirty": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "url",
        "commit",
        "commitDate",
        "dirty"
      ],
      "additionalProperties": false
    },
    "build": {
      "type": "object",
      "properties": {
        "id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ],
          "description": "Content-addressed build identifier (hash of the integrity list)"
        },
        "version": {
          "type": "string"
        },
        "timestamp": {
          "type": "string"
        },
        "environment": {
          "type": "string",
          "enum": [
            "ci",
            "local"
          ]
        },
        "ci": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "provider": {
                  "type": "string"
                },
                "workflow": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "runId": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "runAttempt": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "runUrl": {
                  "anyOf": [
                    {
                      "type": "string",
                      "format": "uri"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "provider",
                "workflow",
                "runId",
                "runAttempt",
                "runUrl"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "clean",
            "modified",
            "declared",
            "unknown"
          ]
        },
        "derived": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "version",
        "timestamp",
        "environment",
        "ci",
        "status",
        "derived"
      ],
      "additionalProperties": false
    },
    "license": {
      "type": "object",
      "properties": {
        "spdx": {
          "type": "string",
          "pattern": "^[A-Za-z0-9.+-]+( (AND|OR|WITH) [A-Za-z0-9.+-]+)*$",
          "description": "SPDX license expression"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "copyright": {
          "type": "string"
        }
      },
      "required": [
        "spdx",
        "url",
        "copyright"
      ],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "properties": {
        "correspondingSource": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri"
            },
            {
              "type": "null"
            }
          ]
        },
        "archive": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri"
            },
            {
              "type": "null"
            }
          ]
        },
        "declared": {
          "type": "boolean"
        }
      },
      "required": [
        "correspondingSource",
        "archive",
        "declared"
      ],
      "additionalProperties": false
    },
    "artifacts": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "Path relative to this file"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "additionalProperties": false
      }
    },
    "verification": {
      "type": "object",
      "properties": {
        "authenticated": {
          "type": "boolean",
          "const": false
        },
        "note": {
          "type": "string"
        },
        "attestations": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "authenticated",
        "note",
        "attestations"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "$schema",
    "schemaVersion",
    "project",
    "upstream",
    "repository",
    "build",
    "license",
    "source",
    "artifacts",
    "verification"
  ],
  "additionalProperties": false,
  "$id": "https://voltaplan.org/schemas/oss-provenance/build-info-1.0.schema.json",
  "title": "oss-provenance build-info-1.0"
}
