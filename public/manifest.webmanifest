{
  "name": "Voltaplan",
  "short_name": "Voltaplan",
  "description": "Schémas unifilaires, plans de position et tableaux électriques, avec contrôle du RGIE.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#14171c",
  "theme_color": "#1d4ed8",
  "lang": "fr",
  "icons": [
    { "src": "icons/icon-256.png", "sizes": "256x256", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" },
    { "src": "icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "file_handlers": [
    { "action": "./", "accept": { "application/json": [".voltaplan", ".openrgie"] } }
  ]
}
